{
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "https://mapskyapp.vercel.app/api/auth/:path*" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/features", "destination": "/features.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/account", "destination": "/account.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/events", "destination": "/events.html" },
    { "source": "/events/buy", "destination": "/events-buy.html" }
  ],
  "redirects": [
    { "source": "/privacy.html", "destination": "/privacy", "permanent": true },
    { "source": "/features.html", "destination": "/features", "permanent": true },
    { "source": "/login.html", "destination": "/login", "permanent": true },
    { "source": "/account.html", "destination": "/account", "permanent": true },
    { "source": "/admin.html", "destination": "/admin", "permanent": true },
    { "source": "/events.html", "destination": "/events", "permanent": true },
    { "source": "/events-buy.html", "destination": "/events/buy", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
